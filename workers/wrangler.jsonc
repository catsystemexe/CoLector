{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colector-v2",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/api/*", "/login", "/views", "/views/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "colector-v2",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }],
  "triggers": { "crons": ["*/5 * * * *"] }
}
